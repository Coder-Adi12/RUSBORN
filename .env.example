LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_URL=http://127.0.0.1:8000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
APPOINTMENT_TIMEZONE=Asia/Kolkata
APPOINTMENT_DURATION_MINUTES=30
APPOINTMENT_WORKING_DAYS=1,2,3,4,5
APPOINTMENT_START_TIME=09:00
APPOINTMENT_END_TIME=18:00

EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=
SALES_TEAM_EMAIL=

# Development only: set a real customer UUID from Supabase for LiveKit Console testing
# TEST_CUSTOMER_ID=

# --- Authentication ---
# The environment: 'development', 'staging', or 'production'
ENVIRONMENT=development

# Internal secret for agent <-> backend communication
INTERNAL_API_SECRET=your-secret-key-here

# Dashboard admin credentials
DASHBOARD_USERNAME=operator
DASHBOARD_PASSWORD=operator-password
DASHBOARD_SESSION_SECRET=a-very-long-random-string-for-cookie-signing
